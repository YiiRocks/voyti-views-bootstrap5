{
    "name": "yiirocks/ext-template",
    "description": "Template for Yii.Rocks extensions",
    "type": "library",
    "keywords": [
        "yii",
        "yii3",
        "extension"
    ],
    "homepage": "https://www.yii.rocks/ext-template/",
    "license": "BSD-3-Clause",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "authors": [
        {
            "name": "Mr.42",
            "homepage": "https://mr42.me/",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/YiiRocks/ext-template/issues",
        "source": "https://github.com/YiiRocks/ext-template/tree/main"
    },
    "require": {
        "php": ">=8.3"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "@stable",
        "infection/infection": "^0.35.0",
        "phpunit/phpunit": "@stable",
        "rector/rector": "^2.1.1",
        "vimeo/psalm": "^6.0",
        "yiisoft/code-style": "^1.1"
    },
    "autoload": {
        "psr-4": {
            "YiiRocks\\ExtTemplate\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "YiiRocks\\ExtTemplate\\tests\\": "tests"
        }
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://asset-packagist.org"
        }
    ],
    "scripts": {
        "php-cs-fixer": "@php vendor/bin/php-cs-fixer fix",
        "phpunit": "@php vendor/bin/phpunit",
        "psalm": "@php vendor/bin/psalm",
        "infection": "@php vendor/bin/infection",
        "rector": "@php vendor/bin/rector process"
    },
    "scripts-descriptions": {
        "php-cs-fixer": "Cleans to code with PHP Coding Standards Fixer.",
        "phpunit": "PHPUnit - programmer-oriented testing framework.",
        "psalm": "Psalm - static analysis tool for finding errors in PHP applications.",
        "infection": "Infection - PHP Mutation Testing Framework.",
        "rector": "Rector - automated tool for refactoring and upgrading PHP code."
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.0.x-dev"
        },
        "config-plugin-options": {
            "source-directory": "config"
        },
        "config-plugin": {
            "params": "params.php",
            "di": "di.php"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "infection/extension-installer": true,
            "yiisoft/config": true
        }
    },
    "funding": [
        {
            "type": "github",
            "url": "https://github.com/sponsors/YiiRocks"
        }
    ]
}
